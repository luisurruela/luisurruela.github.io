  }
  .background span:nth-child(8) {
    color: #e6ecee;
    top: 54%;
    left: 17%;
    animation-duration: 20s;
    animation-delay: -3s;
    transform-origin: 20vw -6vh;
    box-shadow: -40vmin 0 5.2vmin currentColor;
  }
</style>
