---
// Ambient animated floating background shapes with pointer-events disabled to preserve interactivity.
---

<div class="background pointer-events-none z-0" aria-hidden="true">
  <span />
  <span />
  <span />
  <span />
  <span />
  <span />
  <span />
  <span />
</div>

<style>
  @keyframes move {
    100% {
      transform: translate3d(0, 0, 1px) rotate(360deg);
    }
  }

  .background {
    position: fixed;
    width: 100vw;
    height: 100vh;
    top: 0;
    left: 0;
    overflow: hidden;
  }

  .background span {
    width: 30vmin;
    height: 30vmin;
    border-radius: 30vmin;
    backface-visibility: hidden;
    position: absolute;
    animation: move 45s linear infinite;
  }

  .background span:nth-child(1) {
    color: #e9e5f1;
    top: 1%;
    left: 6%;
    animation-duration: 40s;
    animation-delay: -50s;
    transform-origin: 19vw -24vh;
    box-shadow: -40vmin 0 5.2vmin currentColor;
  }
  .background span:nth-child(2) {
    color: #e9e5f1;
    top: 66%;
    left: 4%;
    animation-duration: 43s;
    animation-delay: -10s;
    transform-origin: -17vw 20vh;
    box-shadow: -40vmin 0 5.8vmin currentColor;
  }
  .background span:nth-child(3) {
    color: #e2eff3;
    top: 19%;
    left: 98%;
    animation-duration: 15s;
    animation-delay: -35s;
    transform-origin: 1vw 7vh;
    box-shadow: -40vmin 0 5.5vmin currentColor;
  }
  .background span:nth-child(4) {
    color: #e2eff3;
    top: 71%;
    left: 3%;
    animation-duration: 54s;
    animation-delay: -12s;
    transform-origin: -1vw 8vh;
    box-shadow: -40vmin 0 5.9vmin currentColor;
  }
  .background span:nth-child(5) {
    color: #e9e5f1;
    top: 60%;
    left: 76%;
    animation-duration: 19s;
    animation-delay: -4s;
    transform-origin: 6vw -9vh;
    box-shadow: -40vmin 0 5.6vmin currentColor;
  }
  .background span:nth-child(6) {
    color: #e2eff3;
    top: 37%;
    left: 5%;
    animation-duration: 28s;
    animation-delay: -43s;
    transform-origin: -6vw 17vh;
