---
// Flagship product section promoting the Restaurant Digital Menu & WhatsApp Ordering App based on the Sazón Casero success story.
import { Icon } from "astro-icon/components";
import { useTranslations } from "../../i18n/utils";
import { languages, restaurantAppShowcase } from "../../i18n/ui";

const currentLanguage = (Astro.currentLocale || "es") as keyof typeof languages;
const t = useTranslations(currentLanguage);
const showcaseTabs = restaurantAppShowcase[currentLanguage];

const restaurantInterestValue = t("contact.form.interest.restaurant");
---

<section
  id="productos"
  class="relative py-20 md:py-28 px-5 md:px-8 bg-gradient-to-b from-amber-50/70 via-white/90 to-primary/5 border-y border-amber-900/10"
>
  <div class="max-w-6xl mx-auto">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12" data-aos="fade-up">
      <div class="flex flex-wrap items-center justify-center gap-2 mb-4">
        <span
          class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-amber-500/15 border border-amber-600/30 text-amber-900 text-xs font-bold uppercase tracking-wider"
        >
          <Icon name="mdi:silverware-fork-knife" size={15} />
          <span>{t("products.badge")}</span>
        </span>
        <span
          class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-emerald-500/15 border border-emerald-600/30 text-emerald-800 text-xs font-semibold"
        >
          <Icon name="mdi:check-decagram" size={15} />
          <span>{t("products.case-study-badge")}</span>
        </span>
      </div>

      <h2 class="text-2xl sm:text-3xl md:text-5xl font-heading text-black/90 leading-tight mb-4">
        {t("products.title")}
      </h2>

      <p class="text-sm sm:text-base md:text-lg text-black/70 leading-relaxed mb-4">
        {t("products.subtitle")}
      </p>

      <p class="text-xs sm:text-sm text-amber-950/80 bg-amber-100/70 border border-amber-300/60 rounded-2xl p-4 max-w-2xl mx-auto">
        {t("products.problem-solution")}
      </p>
    </div>

    <!-- Interactive Product Tabs Showcase -->
    <div
      class="rounded-3xl bg-white border border-black/10 shadow-xl overflow-hidden mb-14"
      data-aos="fade-up"
      data-aos-delay="100"
    >
      <!-- Tab Navigation Header -->
      <div
        class="flex overflow-x-auto border-b border-black/10 bg-stone-50/80 p-2 gap-2"
        role="tablist"
        aria-label="Restaurant App Modules"
      >
        {
          showcaseTabs.map((tab, index) => (
            <button
              type="button"
              role="tab"
              aria-selected={index === 0 ? "true" : "false"}
              data-product-tab={tab.id}
              class={`product-tab-btn flex-1 min-w-[170px] py-3 px-4 rounded-2xl text-xs sm:text-sm font-bold transition-all duration-200 cursor-pointer flex items-center justify-center gap-2 ${
                index === 0
                  ? "bg-amber-700 text-white shadow-md"
                  : "text-black/65 hover:bg-black/5 hover:text-black"
              }`}
            >
              <Icon
                name={
                  index === 0
                    ? "mdi:food-fork-drink"
                    : index === 1
                      ? "mdi:cellphone-cog"
                      : index === 2
                        ? "cib:whatsapp"
                        : "mdi:storefront-outline"
                }
                size={18}
              />
              <span>{tab.label}</span>
            </button>
          ))
        }
      </div>

      <!-- Tab Panels -->
      <div class="p-6 sm:p-8 lg:p-10">
        {
          showcaseTabs.map((tab, index) => (
            <div
              data-product-panel={tab.id}
              class={`product-tab-panel grid grid-cols-1 lg:grid-cols-12 gap-8 items-center ${
                index === 0 ? "" : "hidden"
              }`}
            >
              <!-- Left Column: Feature Details -->
              <div class="lg:col-span-5 space-y-5">
                <span class="inline-block px-3 py-1 rounded-lg bg-amber-100 text-amber-900 text-xs font-bold uppercase tracking-wider">
                  {tab.badge}
                </span>

                <h3 class="text-xl sm:text-2xl md:text-3xl font-bold text-black/90 leading-snug">
                  {tab.title}
                </h3>

                <p class="text-sm sm:text-base text-black/65 leading-relaxed">
                  {tab.description}
                </p>

                <ul class="space-y-3 pt-1">
                  {tab.highlights.map((item) => (
                    <li class="flex items-start gap-2.5 text-xs sm:text-sm text-black/80 font-medium">
                      <Icon
                        name="mdi:check-circle"
                        size={20}
                        class="text-emerald-600 shrink-0 mt-0.5"
                      />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>

                <div class="pt-3 flex flex-col sm:flex-row gap-3">
                  <a
                    href="#contacto"
                    data-select-interest={restaurantInterestValue}
                    class="product-interest-btn inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-amber-700 hover:bg-amber-800 text-white text-xs sm:text-sm font-semibold shadow-md transition-all"
                  >
                    <Icon name="mdi:store-check-outline" size={18} />
                    <span>{t("products.cta.demo")}</span>
                  </a>
                </div>
              </div>

              <!-- Right Column: Browser Mockup Screenshot -->
              <div class="lg:col-span-7">
                <div class="rounded-2xl border border-black/15 bg-stone-900 shadow-2xl overflow-hidden">
                  <!-- Browser Top Bar -->
                  <div class="flex items-center justify-between px-4 py-2.5 bg-stone-800 border-b border-white/10">
                    <div class="flex items-center gap-1.5">
                      <span class="w-3 h-3 rounded-full bg-rose-500" />
                      <span class="w-3 h-3 rounded-full bg-amber-400" />
                      <span class="w-3 h-3 rounded-full bg-emerald-500" />
                    </div>
                    <div class="px-3 py-0.5 rounded-md bg-stone-950/60 text-[11px] text-white/70 font-mono truncate max-w-[240px] sm:max-w-xs">
                      tu-restaurante.com • Sazón Casero v2.0
                    </div>
                    <span class="text-[10px] font-semibold text-amber-400 uppercase">
                      Live App
                    </span>
                  </div>

                  <!-- Screenshot Image -->
                  <div class="bg-stone-100 max-h-[380px] overflow-hidden">
                    <img
                      src={tab.image}
                      alt={tab.title}
                      class="w-full h-auto object-cover object-top"
                      loading="lazy"
                    />
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- 3-Step Workflow + Mobile Preview -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-8 space-y-6" data-aos="fade-right">
        <h3 class="text-xl sm:text-2xl font-heading text-black/90">
          {t("products.steps.title")}
        </h3>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="rounded-2xl bg-white p-5 border border-black/10 shadow-xs">
            <div class="w-10 h-10 rounded-xl bg-amber-500/15 text-amber-800 flex items-center justify-center mb-3">
              <Icon name="mdi:silverware-variant" size={22} />
            </div>
            <h4 class="font-bold text-sm sm:text-base text-black/90 mb-1.5">
              {t("products.step1.title")}
            </h4>
            <p class="text-xs sm:text-sm text-black/65 leading-relaxed">
              {t("products.step1.desc")}
            </p>
          </div>

          <div class="rounded-2xl bg-white p-5 border border-black/10 shadow-xs">
            <div class="w-10 h-10 rounded-xl bg-emerald-500/15 text-emerald-700 flex items-center justify-center mb-3">
              <Icon name="cib:whatsapp" size={20} />
            </div>
            <h4 class="font-bold text-sm sm:text-base text-black/90 mb-1.5">
              {t("products.step2.title")}
            </h4>
            <p class="text-xs sm:text-sm text-black/65 leading-relaxed">
              {t("products.step2.desc")}
            </p>
          </div>

          <div class="rounded-2xl bg-white p-5 border border-black/10 shadow-xs">
            <div class="w-10 h-10 rounded-xl bg-primary/15 text-primary flex items-center justify-center mb-3">
              <Icon name="mdi:toggle-switch-outline" size={24} />
            </div>
            <h4 class="font-bold text-sm sm:text-base text-black/90 mb-1.5">
              {t("products.step3.title")}
            </h4>
            <p class="text-xs sm:text-sm text-black/65 leading-relaxed">
              {t("products.step3.desc")}
            </p>
          </div>
        </div>

        <!-- Bottom CTA Bar -->
        <div class="rounded-2xl bg-gradient-to-r from-amber-800 via-amber-700 to-amber-900 text-white p-6 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-lg">
          <div>
            <div class="text-xs font-bold uppercase tracking-wider text-amber-200 mb-1">
              {t("products.zero-commission")}
            </div>
            <p class="text-sm sm:text-base font-medium text-white/95">
              ¿Tienes un restaurante, fonda, cafetería o cocina económica? Implementemos tu propia plataforma hoy mismo.
            </p>
          </div>
          <a
            href="https://wa.me/529932090424?text=Hola%20Luis%2C%20me%20interesa%20una%20demo%20de%20la%20App%20para%20Restaurantes%20como%20la%20de%20Saz%C3%B3n%20Casero"
            target="_blank"
            rel="noopener noreferrer"
            class="shrink-0 w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-white text-amber-900 font-bold text-xs sm:text-sm hover:bg-amber-50 transition-colors shadow-md"
          >
            <Icon name="cib:whatsapp" size={18} class="text-emerald-600" />
            <span>{t("products.cta.whatsapp")}</span>
          </a>
        </div>
      </div>

      <!-- Mobile Phone Frame Preview -->
      <div class="lg:col-span-4 flex justify-center" data-aos="fade-left">
        <div class="w-[240px] sm:w-[260px] rounded-[36px] border-[8px] border-stone-900 bg-stone-900 shadow-2xl overflow-hidden">
          <div class="h-5 bg-stone-900 flex items-center justify-center">
            <span class="w-16 h-1.5 rounded-full bg-stone-700" />
          </div>
          <img
            src="/images/apps/home_mobile.png"
            alt="Vista móvil de la App para Restaurantes Sazón Casero"
            class="w-full h-[400px] object-cover object-top bg-white"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Interactive tab switcher for the Restaurant App showcase panels.
  const tabButtons = document.querySelectorAll(".product-tab-btn");
  const tabPanels = document.querySelectorAll(".product-tab-panel");

  tabButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const targetId = btn.getAttribute("data-product-tab");
      if (!targetId) return;

      tabButtons.forEach((b) => {
        const isActive = b.getAttribute("data-product-tab") === targetId;
        b.setAttribute("aria-selected", isActive ? "true" : "false");
        if (isActive) {
          b.classList.add("bg-amber-700", "text-white", "shadow-md");
          b.classList.remove("text-black/65", "hover:bg-black/5", "hover:text-black");
        } else {
          b.classList.remove("bg-amber-700", "text-white", "shadow-md");
          b.classList.add("text-black/65", "hover:bg-black/5", "hover:text-black");
        }
      });

      tabPanels.forEach((panel) => {
        if (panel.getAttribute("data-product-panel") === targetId) {
          panel.classList.remove("hidden");
        } else {
          panel.classList.add("hidden");
        }
      });
    });
  });

  // Pre-selects the Restaurant App interest option when clicking the demo CTA.
  const productInterestButtons = document.querySelectorAll(".product-interest-btn");
  productInterestButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const interest = button.getAttribute("data-select-interest");
      const interestSelect = document.querySelector(
        "#contact-interest"
      ) as HTMLSelectElement | null;
      if (interest && interestSelect) {
        interestSelect.value = interest;
        interestSelect.dispatchEvent(new Event("change"));
      }
    });
  });
</script>
