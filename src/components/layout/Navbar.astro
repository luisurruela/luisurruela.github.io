---
// Responsive sticky navigation bar with anchor links, language switcher, and mobile drawer.
import { Icon } from "astro-icon/components";
import { useTranslations } from "../../i18n/utils";
import { languages } from "../../i18n/ui";

const currentLanguage = (Astro.currentLocale || "es") as keyof typeof languages;
const t = useTranslations(currentLanguage);

const homeHref = currentLanguage === "en" ? "/en/" : "/";
const altLangHref = currentLanguage === "en" ? "/" : "/en/";
const altLangLabel = currentLanguage === "en" ? "ES" : "EN";

const menuLinks = [
  { name: t("nav.home"), url: "#inicio" },
  { name: t("nav.services"), url: "#servicios" },
  { name: t("nav.products"), url: "#productos" },
  { name: t("nav.contact"), url: "#contacto" },
];
---

<header class="sticky top-0 z-50 w-full bg-white/80 backdrop-blur-md border-b border-black/5">
  <nav class="max-w-6xl mx-auto flex items-center justify-between py-3.5 px-5 md:px-8">
    <!-- Brand Logo -->
    <a href={homeHref} class="flex items-center gap-2.5 group">
      <Icon
        name="logo"
        size={38}
        class="text-primary transition-transform duration-300 group-hover:scale-105"
      />
      <div class="flex flex-col leading-none">
        <span class="font-heading text-lg md:text-xl text-black/90 tracking-wide">
          Luis Urruela
        </span>
        <span class="text-[11px] font-medium text-secondary tracking-wider uppercase">
          Full-Stack & Apps
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <ul class="hidden md:flex items-center gap-7">
      {
        menuLinks.map((link) => (
          <li>
            <a
              href={link.url}
              class="nav-link text-sm font-medium text-black/70 hover:text-primary transition-colors duration-200 py-1"
            >
              {link.name}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Desktop Actions -->
    <div class="hidden md:flex items-center gap-3">
      <a
        href={altLangHref}
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold border border-black/10 text-black/70 hover:border-primary hover:text-primary transition-colors"
        title={t("nav.language")}
      >
        <Icon name="mdi:translate" size={15} />
        <span>{altLangLabel}</span>
      </a>
      <a
        href="#contacto"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-semibold bg-primary text-white hover:bg-primary-dark transition-all duration-200 shadow-sm hover:shadow-md"
      >
        <Icon name="mdi:message-fast-outline" size={16} />
        <span>{t("nav.cta")}</span>
      </a>
    </div>

    <!-- Mobile Menu Trigger -->
    <div class="flex md:hidden items-center gap-2">
      <a
        href={altLangHref}
        class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold border border-black/10 text-black/75"
      >
        <Icon name="mdi:translate" size={14} />
        <span>{altLangLabel}</span>
      </a>
      <button
        id="menu-button"
        type="button"
        aria-label={t("nav.menu")}
        class="p-2 rounded-lg text-black/75 hover:bg-black/5 cursor-pointer"
      >
        <Icon name="mdi:menu" size={28} />
      </button>
    </div>
  </nav>
</header>

<!-- Mobile Drawer -->
<aside
  id="mobile-drawer"
  class="bg-white/95 backdrop-blur-xl w-[80%] max-w-xs h-screen fixed top-0 right-0 z-50 md:hidden border-l border-black/10 shadow-2xl transform transition-transform duration-300 ease-in-out translate-x-full flex flex-col justify-between p-6"
>
  <div>
    <div class="flex items-center justify-between pb-4 border-b border-black/10">
      <span class="font-heading text-lg text-primary">{t("nav.menu")}</span>
      <button
        id="close-button"
        type="button"
        aria-label="Close menu"
        class="p-1.5 rounded-lg text-black/60 hover:text-primary cursor-pointer"
      >
        <Icon name="mdi:close" size={26} />
      </button>
    </div>

    <ul class="mt-6 flex flex-col gap-3">
      {
        menuLinks.map((link) => (
          <li>
            <a
              href={link.url}
              class="mobile-nav-link block py-2.5 px-3 rounded-xl text-base font-medium text-black/80 hover:bg-primary/10 hover:text-primary transition-colors"
            >
              {link.name}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="pt-4 border-t border-black/10">
    <a
      href="https://wa.me/529932090424?text=Hola%20Luis%2C%20me%20interesa%20tu%20servicio"
      target="_blank"
      rel="noopener noreferrer"
      class="w-full py-3 px-4 rounded-xl bg-primary text-white text-sm font-semibold flex items-center justify-center gap-2 shadow-md"
    >
      <Icon name="cib:whatsapp" size={18} />
      <span>WhatsApp Directo</span>
    </a>
  </div>
</aside>

<div
  id="overlay"
  class="w-full h-screen bg-black/30 backdrop-blur-xs fixed top-0 left-0 z-40 hidden transition-opacity duration-300 ease-in-out md:hidden"
/>

<script>
  const menuButton = document.querySelector("#menu-button");
  const closeButton = document.querySelector("#close-button");
  const mobileDrawer = document.querySelector("#mobile-drawer");
  const overlay = document.querySelector("#overlay");
  const mobileLinks = document.querySelectorAll(".mobile-nav-link");

  function openMenu() {
    if (!mobileDrawer || !overlay) return;
    mobileDrawer.classList.remove("translate-x-full");
    overlay.classList.remove("hidden");
  }

  function closeMenu() {
    if (!mobileDrawer || !overlay) return;
    mobileDrawer.classList.add("translate-x-full");
    overlay.classList.add("hidden");
  }

  menuButton?.addEventListener("click", openMenu);
  closeButton?.addEventListener("click", closeMenu);
  overlay?.addEventListener("click", closeMenu);
  mobileLinks.forEach((link) => link.addEventListener("click", closeMenu));
</script>

<style>
  .nav-link {
    position: relative;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(to right, var(--color-primary), var(--color-secondary));
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.25s ease-out;
  }

  .nav-link:hover::after {
    transform: scaleX(1);
  }
</style>
